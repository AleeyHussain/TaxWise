# Copy this file to .env.local and add your own values.
# The AI assistant uses Groq's OpenAI-compatible chat API.
# If no key is set, the app falls back to the built-in simulated assistant,
# so the project still runs fully without a key.

GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model.
# GROQ_MODEL=llama-3.3-70b-versatile

# Admin credentials & session signing
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "YOUR_PASSWORD"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$PLACEHOLDER_BCRYPT_HASH_HERE
ADMIN_SESSION_SECRET=change_this_to_at_least_32_random_bytes_secret_key_here
